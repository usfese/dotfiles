layout {

    focus-ring {
        active-color   "#53dbc9"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#53dbc9"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#53dbc9"
        inactive-color "#005048"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#53dbc980"
    }
}

recent-windows {
    highlight {
        active-color "#53dbc9"
        urgent-color "#ffb4ab"
    }
}
