layout {

    focus-ring {
        active-color   "#ffb0cb"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb0cb"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb0cb"
        inactive-color "#7a294c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb0cb80"
    }
}

recent-windows {
    highlight {
        active-color "#ffb0cb"
        urgent-color "#ffb4ab"
    }
}
