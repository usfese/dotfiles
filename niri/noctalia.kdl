layout {

    focus-ring {
        active-color   "#7ed0ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#7ed0ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#7ed0ff"
        inactive-color "#004c6a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#7ed0ff80"
    }
}

recent-windows {
    highlight {
        active-color "#7ed0ff"
        urgent-color "#ffb4ab"
    }
}
